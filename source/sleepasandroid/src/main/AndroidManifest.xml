<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.urbandroid.sleep" />
    </queries>

    <application>
        <receiver
            android:name=".SleepAsAndroidBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.urbandroid.sleep.alarmclock.SLEEP_TRACKING_STOPPED" />
                <action android:name="com.urbandroid.sleep.alarmclock.ALARM_ALERT_DISMISS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
