    <!-- 1 Welcome -->
    <string name="ob_welcome_title">Know your energy before the day starts.</string>
    <string name="ob_welcome_body">Drift turns your sleep into a simple schedule for the day.</string>
    <string name="ob_welcome_energy_title">Your energy schedule</string>
    <string name="ob_welcome_energy_body">See when you are likely to peak, dip and wind down.</string>
    <string name="ob_welcome_debt_title">Your sleep debt</string>
    <string name="ob_welcome_debt_body">Track what short nights cost you and how fast you repay it.</string>
    <string name="ob_welcome_clock_title">Your body clock</string>
    <string name="ob_welcome_clock_body">Learn when you naturally feel sleepy and how regular your sleep is.</string>
    <string name="ob_welcome_private">Everything stays on your phone.</string>
    <string name="ob_get_started">Get started</string>

    <!-- 2 How it works -->
    <string name="ob_how_title">How Drift works</string>
    <string name="ob_how_body">Every number carries a label that says where it came from.</string>
    <string name="ob_how_energy_title">Energy</string>
    <string name="ob_how_energy_body">A model combines how long you have been awake, your body clock and how well you slept. It is an estimate with a margin of error.</string>
    <string name="ob_how_debt_title">Sleep debt</string>
    <string name="ob_how_debt_body">Calculated from your recent nights against the sleep you need. Short nights add to it and long nights pay it back gradually.</string>
    <string name="ob_how_clock_title">Body clock</string>
    <string name="ob_how_clock_body">Estimated from when you usually sleep. The more regular nights Drift sees, the narrower the margin becomes.</string>
    <string name="ob_how_measured">Anything read straight from your phone or a connected app is labelled Measured.</string>

    <!-- 3 Schedule -->
    <string name="ob_schedule_title">Your usual week</string>
    <string name="ob_schedule_body">This gives Drift a starting point before it has seen any of your nights.</string>
    <string name="ob_workdays_label">Work or school days</string>
    <string name="ob_workdays_none">No fixed days selected. Drift will treat every day as a free day.</string>
    <string name="ob_day_selected">%1$s, selected</string>
    <string name="ob_day_not_selected">%1$s, not selected</string>
    <string name="ob_wake_workday">Wake-up time on work days</string>
    <string name="ob_bed_free">Bedtime on free days</string>
    <string name="ob_wake_free">Wake-up time on free days</string>
    <string name="ob_time_earlier_desc">Make %1$s earlier</string>
    <string name="ob_time_later_desc">Make %1$s later</string>
    <string name="ob_time_value_desc">%1$s: %2$s</string>

    <!-- 4 About you -->
    <string name="ob_about_title">About you</string>
    <string name="ob_about_body">Age shapes how much sleep people typically need. Your answers stay on this phone.</string>
    <string name="ob_age_label">Age</string>
    <string name="ob_age_18_25">18 to 25</string>
    <string name="ob_age_26_35">26 to 35</string>
    <string name="ob_age_36_50">36 to 50</string>
    <string name="ob_age_51_64">51 to 64</string>
    <string name="ob_age_65_plus">65 or older</string>
    <string name="ob_chrono_label">Are you a morning or an evening person?</string>
    <string name="ob_chrono_definitely_morning">Definitely a morning person</string>
    <string name="ob_chrono_moderately_morning">More of a morning person</string>
    <string name="ob_chrono_neither">Neither</string>
    <string name="ob_chrono_moderately_evening">More of an evening person</string>
    <string name="ob_chrono_definitely_evening">Definitely an evening person</string>
    <string name="ob_chrono_unsure">I am not sure</string>
    <string name="ob_save_failed">Drift could not save your answers: %1$s</string>

    <!-- 5 Sources -->
    <string name="ob_sources_title">Where should Drift read sleep from?</string>
    <string name="ob_sources_body">Pick one or more. Drift merges them and prefers the most accurate source for each night.</string>
    <string name="ob_source_hc_hint">Most accurate when you wear a watch or ring that writes to Health Connect.</string>
    <string name="ob_source_saa_hint">Reads sleep that Sleep as Android records. You can also import its backup file.</string>
    <string name="ob_source_phone_hint">No wearable needed. Drift infers sleep from how your phone is used, which is less accurate.</string>
    <string name="ob_source_phone_name">Phone detection</string>
    <string name="ob_source_hint_generic">Another sleep source.</string>
    <string name="ob_source_status_available">Connected</string>
    <string name="ob_source_status_needs_permission">Needs permission</string>
    <string name="ob_source_status_not_installed">Not installed</string>
    <string name="ob_source_status_not_supported">Not supported on this phone</string>
    <string name="ob_source_status_error">Problem: %1$s</string>
    <string name="ob_source_status_off">Off</string>
    <string name="ob_sources_none">No sources are available yet. You can add sleep by hand later.</string>

    <!-- 6 Permissions -->
    <string name="ob_perm_hc_title">Read sleep from Health Connect</string>
    <string name="ob_perm_hc_body">Drift reads sleep sessions and, if present, heart rate and steps. It stays on your phone. There is no account and no network access.</string>
    <string name="ob_perm_hc_point_1">Sleep sessions and stages</string>
    <string name="ob_perm_hc_point_2">Used only to build your schedule on this phone</string>
    <string name="ob_perm_hc_granted">Access granted</string>
    <string name="ob_perm_hc_missing">Still missing</string>
    <string name="ob_perm_hc_ok">Granted</string>
    <string name="ob_perm_hc_not_granted">Not granted</string>
    <string name="ob_perm_hc_connected_title">Health Connect is connected</string>
    <string name="ob_perm_hc_connected_body">Drift has the access it asked for.</string>
    <string name="ob_perm_hc_missing_title">Health Connect is not installed</string>
    <string name="ob_perm_hc_missing_body">Install it to read sleep from your watch or ring, or carry on with phone detection only.</string>
    <string name="ob_perm_hc_update_body">Health Connect needs an update before Drift can read from it.</string>
    <string name="ob_perm_hc_unsupported_body">Health Connect is not supported on this phone. Phone detection still works.</string>
    <string name="ob_perm_use_phone_only">Use phone detection only</string>
    <string name="ob_perm_activity_title">Activity recognition</string>
    <string name="ob_perm_activity_body">Lets Drift use Android\'s sleep detection and count steps. Without it, Drift relies on screen use and has lower confidence.</string>
    <string name="ob_perm_activity_point_1">Sleep and movement signals from the phone</string>
    <string name="ob_perm_activity_point_2">Never leaves your phone</string>
    <string name="ob_perm_activity_action">Allow activity recognition</string>
    <string name="ob_perm_usage_title">Usage access</string>
    <string name="ob_perm_usage_body">Lets Drift see when the screen was last in use overnight, which helps place bedtime and wake time. It never reads what you do in other apps.</string>
    <string name="ob_perm_usage_point_1">When the phone was in use, not what was on screen</string>
    <string name="ob_perm_usage_point_2">Never leaves your phone</string>
    <string name="ob_perm_usage_action">Open usage access settings</string>
    <string name="ob_perm_notif_title">Reminders</string>
    <string name="ob_perm_notif_body">Drift can nudge you to wind down, get morning light and confirm last night\'s sleep. If you skip this, the same cards appear inside the app.</string>
    <string name="ob_perm_notif_point_1">Wind-down and morning reminders</string>
    <string name="ob_perm_notif_point_2">You choose which ones in Settings</string>
    <string name="ob_perm_notif_action">Allow notifications</string>
    <string name="ob_perm_granted_title">%1$s: allowed</string>
    <string name="ob_perm_granted_body">Nothing more to do here.</string>
    <string name="ob_perm_denied_note">Not allowed. You can change this later in Settings.</string>

